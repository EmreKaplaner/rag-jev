TYPESAFE_API_KEY=
RAG_JEV_MODEL=jev-latest
RAG_JEV_TIMEOUT_MS=5000
RAG_JEV_MAX_CONCURRENCY=8
# Optional bearer token for the selection service, separate from the TypeSafe key.
RAG_JEV_API_TOKEN=

# Optional answer comparison; /chat/completions is appended to this base URL.
RAG_JEV_GENERATION_BASE_URL=
RAG_JEV_GENERATION_MODEL=
RAG_JEV_GENERATION_API_KEY=
RAG_JEV_GENERATION_TOKEN_LIMIT_FIELD=max_completion_tokens
RAG_JEV_GENERATION_MAX_OUTPUT_TOKENS=700
# Optional for reasoning models, e.g. low for a GPT-5.6 Luna pilot.
RAG_JEV_GENERATION_REASONING_EFFORT=
# On https://api.openai.com/v1 only, OPENAI_API_KEY is accepted as a fallback.
# Optional USD per-million rates. Missing rates display "unavailable", never $0.
RAG_JEV_GENERATION_INPUT_PER_MILLION=
RAG_JEV_GENERATION_OUTPUT_PER_MILLION=
RAG_JEV_SCORING_INPUT_PER_MILLION=
RAG_JEV_SCORING_OUTPUT_PER_MILLION=
