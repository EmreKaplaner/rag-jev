        },
        {
          "id": "8d51f8967ed0a572",
          "text": "# Shipping and delivery",
          "metadata": {
            "source": "shipping.md",
            "paragraph": 1
          },
          "group_id": null,
          "pinned": false
        },
        {
          "id": "e218c4caf0884cb3",
          "text": "Orders usually ship within 5 business days. Delivery estimates start when a package leaves the warehouse.",
          "metadata": {
            "source": "shipping.md",
            "paragraph": 2
          },
          "group_id": null,
          "pinned": false
        },
        {
          "id": "798d7a70f8a9d759",
          "text": "Refunds are returned to the original payment method after the returned item has been inspected.",
          "metadata": {
            "source": "refunds.md",
            "paragraph": 3
          },
          "group_id": null,
          "pinned": false
        },
        {
          "id": "e8b2791e8882aa22",
          "text": "The order tracking page shows the carrier, tracking number, and expected delivery date.",
          "metadata": {
            "source": "shipping.md",
            "paragraph": 3
          },
          "group_id": null,
          "pinned": false
        },
        {
          "id": "ddfbe4978410ff13",
          "text": "Subscriptions renew annually, not every 30 days. Renewal is automatic unless the subscription is canceled before the renewal date.",
          "metadata": {
            "source": "subscriptions.md",
            "paragraph": 2
          },
          "group_id": null,
          "pinned": false
        }
      ]
    },
